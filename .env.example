# Copy this file to .env and fill in the values you need.
#   cp .env.example .env

# ---------- LLM provider ----------
# One of: huggingface | groq | ollama
LLM_PROVIDER=huggingface

# Hugging Face Inference (LLM_PROVIDER=huggingface)
HF_TOKEN=your_hf_token_here
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# Groq (LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama, runs locally (LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Max tool-calling steps per question
AGENT_MAX_STEPS=1

# Return canned responses instead of calling an LLM (no keys needed)
USE_MOCK_LLM=false

# ---------- Tools ----------
# Optional: raises the GitHub search rate limit
GITHUB_TOKEN=your_github_token_here

# ---------- Backend ----------
# Defaults to a SQLite file in the project root
# DATABASE_URL=sqlite:///./research_compass.db
CORS_ORIGINS=http://localhost:5173
